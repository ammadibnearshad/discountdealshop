{% comment %}
  DDS spec table — a card of two-column rows.
  Reference: _reference/dds-product.html → .spec (Item details) and
  .setlist (What's in the set).

  Both reference lists are the same thing: a name and its value. They differ
  only in where the value sits, so this is one section with a layout switch
  rather than two near-identical sections.

  Marked up as a <dl>: every row is a name/value pair, which is exactly what
  a description list is for.
{% endcomment %}

{{ 'section-dds-spec-table.css' | asset_url | stylesheet_tag }}

{% style %}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | divided_by: 2 }}px;
    padding-bottom: {{ section.settings.padding_bottom | divided_by: 2 }}px;
    --dds-spec-label-w: {{ section.settings.label_width }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{%- liquid
  comment
    A card with a heading and no rows is just a floating title, so the whole
    section is gated on at least one row having text in it.
  endcomment
  assign has_rows = false
  for block in section.blocks
    if block.settings.left != blank or block.settings.right != blank
      assign has_rows = true
      break
    endif
  endfor
-%}

{%- if has_rows -%}
  <div class="dds-spec section-{{ section.id }}">
    <div class="dds-spec__card">
      {%- if section.settings.heading != blank -%}
        <div class="dds-spec__head">
          <h2 class="dds-spec__heading">{{ section.settings.heading | escape }}</h2>
        </div>
      {%- endif -%}

      <dl class="dds-spec__list dds-spec__list--{{ section.settings.layout }}">
        {%- for block in section.blocks -%}
          {%- if block.settings.left != blank or block.settings.right != blank -%}
            <div class="dds-spec__row" {{ block.shopify_attributes }}>
              <dt class="dds-spec__left">{{ block.settings.left | escape }}</dt>
              <dd class="dds-spec__right">{{ block.settings.right | escape }}</dd>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </dl>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "DDS spec table",
  "tag": "section",
  "class": "dds-spec-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to show the rows on their own.",
      "default": "Item details"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        { "value": "label", "label": "Label column" },
        { "value": "list", "label": "Value on the right" }
      ],
      "default": "label",
      "label": "Row layout",
      "info": "Label column puts the left text in a fixed muted column. Value on the right pushes the right text to the far edge and bolds it."
    },
    {
      "type": "range",
      "id": "label_width",
      "min": 80,
      "max": 240,
      "step": 8,
      "unit": "px",
      "label": "Label column width",
      "info": "Label column layout only. Never takes more than 40% of the row on narrow screens.",
      "default": 136
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "left", "label": "Left text", "default": "Label" },
        { "type": "text", "id": "right", "label": "Right text", "default": "Value" }
      ]
    }
  ],
  "presets": [
    {
      "name": "DDS spec table",
      "blocks": [
        { "type": "row" },
        { "type": "row" },
        { "type": "row" }
      ]
    }
  ]
}
{% endschema %}
