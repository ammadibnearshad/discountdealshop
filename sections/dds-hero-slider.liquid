{% comment %}
  DDS hero slider — image left, store message right, on a white card.
  Reference: _reference/dds-home.html → section.hero

  Not built on Dawn's <slideshow-component>: that class only initialises
  `this.reducedMotion` inside its `if (this.announcementBarSlider)` branch, so
  running it without an announcement bar AND without a `.slideshow__autoplay`
  toggle throws in setAutoPlay(). It also hard-codes .slideshow__slide /
  .slider-counter__link markup. See assets/section-dds-hero-slider.js.
{% endcomment %}

{{ 'section-dds-hero-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-dds-hero-slider.js' | asset_url }}" defer="defer"></script>

{% style %}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | divided_by: 2 }}px;
    padding-bottom: {{ section.settings.padding_bottom | divided_by: 2 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<div class="dds-hero section-{{ section.id }}">
  <dds-hero-slider
    class="dds-hero__card color-{{ section.settings.color_scheme }} gradient"
    {% if section.settings.autoplay %}
      data-autoplay="true"
      data-autoplay-speed="{{ section.settings.autoplay_speed }}"
    {% endif %}
    aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
    aria-label="{{ section.settings.accessible_label | escape }}"
  >
    <div class="dds-hero__track" id="DdsHeroTrack-{{ section.id }}" data-hero-track>
      {%- for block in section.blocks -%}
        <div
          class="dds-hero__slide"
          role="group"
          aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
          aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ section.blocks.size }}"
          {{ block.shopify_attributes }}
        >
          {%- liquid
            # First slide is the LCP candidate; the rest stay lazy.
            assign img_loading = 'lazy'
            assign img_priority = 'auto'
            if forloop.first
              assign img_loading = 'eager'
              assign img_priority = 'high'
            endif
            assign img_alt = block.settings.image.alt | default: block.settings.heading | escape
          -%}
          <div class="dds-hero__art">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1500
                | image_tag:
                  class: 'dds-hero__image',
                  widths: '375, 550, 750, 1100, 1500',
                  sizes: '(min-width: 990px) 45vw, 50vw',
                  alt: img_alt,
                  loading: img_loading,
                  fetchpriority: img_priority
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'dds-hero__placeholder' }}
            {%- endif -%}
          </div>

          <div class="dds-hero__copy">
            {%- if block.settings.eyebrow != blank -%}
              <p class="dds-hero__eyebrow">{{ block.settings.eyebrow | escape }}</p>
            {%- endif -%}

            {%- if block.settings.heading != blank -%}
              {%- comment -%}
                Only the first slide can be the page H1, and only when the
                merchant opts in — otherwise every slide would emit one.
              {%- endcomment -%}
              {%- if section.settings.use_h1 and forloop.first -%}
                <h1 class="dds-hero__heading">{{ block.settings.heading | escape }}</h1>
              {%- else -%}
                <h2 class="dds-hero__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <p class="dds-hero__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}

            {%- if block.settings.note != blank -%}
              <p class="dds-hero__note">
                {%- render 'icon-dds-check' -%}
                {{ block.settings.note | escape }}
              </p>
            {%- endif -%}

            {%- if block.settings.cta_label != blank -%}
              <a
                class="dds-hero__cta"
                {% if block.settings.cta_link != blank %}
                  href="{{ block.settings.cta_link }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
              >
                {{ block.settings.cta_label | escape }}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <button
        class="dds-hero__arrow dds-hero__arrow--prev"
        type="button"
        data-hero-prev
        aria-controls="DdsHeroTrack-{{ section.id }}"
        aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
      >
        {%- render 'icon-dds-chevron-left' -%}
      </button>
      <button
        class="dds-hero__arrow dds-hero__arrow--next"
        type="button"
        data-hero-next
        aria-controls="DdsHeroTrack-{{ section.id }}"
        aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
      >
        {%- render 'icon-dds-chevron-right' -%}
      </button>

      <div class="dds-hero__dots">
        {%- for block in section.blocks -%}
          <button
            class="dds-hero__dot"
            type="button"
            data-hero-dot
            aria-controls="DdsHeroTrack-{{ section.id }}"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ section.blocks.size }}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </dds-hero-slider>
</div>

{% schema %}
{
  "name": "DDS hero slider",
  "tag": "section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "accessible_label",
      "label": "Accessible name",
      "info": "Describes the carousel to screen readers. Not shown on the page.",
      "default": "Featured"
    },
    {
      "type": "checkbox",
      "id": "use_h1",
      "default": false,
      "label": "Use first slide heading as the page H1",
      "info": "Leave off when the header logo is already the H1 on this page."
    },
    {
      "type": "header",
      "content": "Slide navigation"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "default": true,
      "label": "t:sections.slideshow.settings.auto_rotate.label"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:sections.slideshow.settings.change_slides_speed.label",
      "default": 6
    },
    {
      "type": "header",
      "content": "t:sections.all.colors.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.slideshow.blocks.slide.settings.image.label"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Kitchen & storage"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.slideshow.blocks.slide.settings.heading.label",
          "default": "Everything your kitchen needs, in one order"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.slideshow.blocks.slide.settings.subheading.label",
          "default": "Jars, racks, organizers and lunch boxes — tested before we list them, priced the way they should be."
        },
        {
          "type": "text",
          "id": "note",
          "label": "Reassurance note",
          "info": "Shown in green with a check mark. Delivery, COD or returns.",
          "default": "Free delivery all over Pakistan"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "t:sections.slideshow.blocks.slide.settings.button_label.label",
          "default": "Shop kitchen"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "t:sections.slideshow.blocks.slide.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DDS hero slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
