{% comment %}
  DDS main product — gallery + savings on the left, everything else as blocks
  on the right.
  Reference: _reference/dds-product.html → .app > .col-a / .col-b

  Wrapped in Dawn's <product-info> so variant changes, URL updates and section
  re-rendering all keep working. Variant picker, quantity input and buy buttons
  are Dawn's own snippets, restyled — reimplementing variant logic would be the
  riskiest thing in this build.

  Mobile is the reference's single-column stack with a fixed bottom CTA bar.
{% endcomment %}

{{ 'section-dds-main-product.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'section-dds-main-product.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign variant = product.selected_or_first_available_variant

  assign sold_raw = product.metafields.custom.units_sold.value | plus: 0

  assign rating = ''
  if product.metafields.reviews.rating.value != blank
    assign rating = product.metafields.reviews.rating.value.rating | round: 1
  endif

  assign on_sale = false
  assign percent_off = 0
  if variant.compare_at_price > variant.price
    assign on_sale = true
    assign saving = variant.compare_at_price | minus: variant.price | times: 100.0
    assign percent_off = saving | divided_by: variant.compare_at_price | round
  endif

  assign show_urgency = false
  if section.settings.urgency_label != blank and variant.inventory_management != blank and variant.inventory_policy == 'deny'
    if variant.inventory_quantity > 0 and variant.inventory_quantity <= section.settings.urgency_threshold
      assign show_urgency = true
    endif
  endif

  assign now_ts = 'now' | date: '%s' | plus: 0
  assign shop_offset = 'now' | date: '%z'

  comment
    Card grouping. Title + price share one card; variant picker, quantity and
    buy buttons share another. Both are computed as the first consecutive run
    of those block types so a merchant reordering blocks in the editor never
    ends up with an unrelated block swallowed into a card.
  endcomment
  assign head_types = 'title,price' | split: ','
  assign head_first = 0
  assign head_last = 0
  assign head_open = false
  assign head_done = false
  for block in section.blocks
    if head_types contains block.type and head_done == false
      unless head_open
        assign head_open = true
        assign head_first = forloop.index
      endunless
      assign head_last = forloop.index
    else
      if head_open
        assign head_done = true
      endif
    endif
  endfor

  assign buy_types = 'variant_picker,quantity,buy_buttons' | split: ','
  assign buy_first = 0
  assign buy_last = 0
  assign buy_open = false
  assign buy_done = false
  for block in section.blocks
    if buy_types contains block.type and buy_done == false
      unless buy_open
        assign buy_open = true
        assign buy_first = forloop.index
      endunless
      assign buy_last = forloop.index
    else
      if buy_open
        assign buy_done = true
      endif
    endif
  endfor

  comment
    Every accordion block shares one card. Same first-consecutive-run rule as
    the two groups above, so a block dropped between two accordions splits the
    card instead of being swallowed by it.
  endcomment
  assign acc_first = 0
  assign acc_last = 0
  assign acc_open = false
  assign acc_done = false
  for block in section.blocks
    if block.type == 'accordion' and acc_done == false
      unless acc_open
        assign acc_open = true
        assign acc_first = forloop.index
      endunless
      assign acc_last = forloop.index
    else
      if acc_open
        assign acc_done = true
      endif
    endif
  endfor

  assign acc_visible = 0
  for block in section.blocks
    if block.type == 'accordion' and forloop.index >= acc_first and forloop.index <= acc_last
      assign acc_row = block.settings.content | append: block.settings.page.content
      if block.settings.heading != blank and acc_row != blank
        assign acc_visible = acc_visible | plus: 1
      endif
    endif
  endfor
-%}

{% style %}
  .section-{{ section.id }} {
    padding-top: 0;
    padding-bottom: {{ section.settings.padding_bottom | divided_by: 2 }}px;
  }

  @media screen and (min-width: 990px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<product-info
  id="MainProduct-{{ section.id }}"
  class="dds-pdp section-{{ section.id }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
>
  <div class="dds-pdp__grid">
    {%- comment -%} Left column: gallery, then the savings strip. {%- endcomment -%}
    <div class="dds-pdp__col-a">
      {%- render 'dds-product-gallery', product: product, section_id: section.id -%}

      {%- if section.settings.savings_items != blank -%}
        <dds-rotator
          class="dds-pdp__savings"
          data-rotate-speed="{{ section.settings.savings_rotate_speed }}"
        >
          {%- if section.settings.savings_tag != blank -%}
            <span class="dds-pdp__savings-tag">
              {%- render 'icon-dds-bolt' -%}
              {{ section.settings.savings_tag | escape }}
            </span>
          {%- endif -%}
          <ul class="dds-pdp__savings-items dds-rotator__track" role="list" data-rotator-items>
            {%- assign savings = section.settings.savings_items | split: ',' -%}
            {%- for item in savings -%}
              {%- assign trimmed = item | strip -%}
              {%- if trimmed != blank -%}
                <li class="dds-pdp__savings-item{% if forloop.first %} is-active{% endif %}">
                  {%- render 'icon-dds-check' -%}
                  {{ trimmed | escape }}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </dds-rotator>
      {%- endif -%}
    </div>

    {%- comment -%} Right column: every element is a block. {%- endcomment -%}
    <div class="dds-pdp__col-b">
      {%- for block in section.blocks -%}
        {%- liquid
          assign in_head = false
          if head_first > 0 and forloop.index >= head_first and forloop.index <= head_last
            assign in_head = true
          endif

          assign in_buy = false
          if buy_first > 0 and forloop.index >= buy_first and forloop.index <= buy_last
            assign in_buy = true
          endif

          assign in_acc = false
          if acc_first > 0 and forloop.index >= acc_first and forloop.index <= acc_last
            assign in_acc = true
          endif
        -%}

        {%- if forloop.index == head_first -%}<div class="dds-pdp__card dds-pdp__headbox">{%- endif -%}
        {%- if forloop.index == buy_first -%}<div class="dds-pdp__card dds-pdp__buybox">{%- endif -%}
        {%- if forloop.index == acc_first and acc_visible > 0 -%}
          <div class="dds-pdp__card dds-pdp__accbox">
            {%- if section.settings.accordion_heading != blank -%}
              <div class="dds-pdp__blockhead">
                <h2>{{ section.settings.accordion_heading | escape }}</h2>
              </div>
            {%- endif -%}
        {%- endif -%}

        {%- case block.type -%}

          {%- when 'title' -%}
            <div class="dds-pdp__part{% unless in_head %} dds-pdp__card{% endunless %}" {{ block.shopify_attributes }}>
              <h1 class="dds-pdp__title">{{ product.title | escape }}</h1>
              <div class="dds-pdp__meta">
                <span class="dds-pdp__meta-left">
                  {%- if block.settings.show_sold and sold_raw > 0 -%}
                    {%- liquid
                      if sold_raw >= 1000
                        assign sold_label = sold_raw | divided_by: 1000 | append: 'K+'
                      else
                        assign sold_label = sold_raw | append: '+'
                      endif
                    -%}
                    <span class="dds-pdp__sold">{{ sold_label }} {{ block.settings.sold_text | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.show_seller -%}
                    {%- if block.settings.show_sold and sold_raw > 0 -%}
                      <span class="dds-pdp__sep" aria-hidden="true">|</span>
                    {%- endif -%}
                    <span class="dds-pdp__seller">
                      {{ block.settings.seller_prefix | escape }} {{ shop.name }}
                      {%- render 'icon-dds-chevron-right' -%}
                    </span>
                  {%- endif -%}
                </span>
                {%- if block.settings.show_rating and rating != blank -%}
                  <span
                    class="dds-pdp__rating"
                    aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: rating, rating_max: product.metafields.reviews.rating.value.scale_max }}"
                  >
                    {{- rating -}}
                  </span>
                {%- endif -%}
              </div>
            </div>

          {%- when 'price' -%}
            <div class="dds-pdp__part{% unless in_head %} dds-pdp__card{% endunless %}" {{ block.shopify_attributes }}>
              <div class="dds-pdp__price-row">
                {%- if on_sale -%}
                  <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
                  <s class="dds-pdp__was" aria-hidden="true">
                    {{- variant.compare_at_price | money_without_currency -}}
                  </s>
                {%- endif -%}
                <span class="dds-pdp__now">{{ variant.price | money }}</span>
                {%- if on_sale -%}
                  <span class="visually-hidden">
                    {{ 'products.product.price.regular_price' | t }} {{ variant.compare_at_price | money }}
                  </span>
                  {%- if block.settings.off_badge_label != blank -%}
                    <span class="dds-pdp__off">
                      {{- percent_off }}{{ block.settings.off_badge_label | escape -}}
                    </span>
                  {%- endif -%}
                {%- endif -%}
              </div>
              {%- if show_urgency -%}
                <span class="dds-pdp__hot">
                  {%- render 'icon-dds-bolt' -%}
                  {{ section.settings.urgency_label | escape }}
                </span>
              {%- endif -%}
            </div>

          {%- when 'countdown' -%}
            {%- comment -%}
              The deadline is set in the theme editor (block settings), with an
              optional per-product override from the custom.sale_ends_at
              metafield. Both are real dates — when the chosen source is empty
              or already past, the bar renders nothing rather than rolling a
              fake deadline.
            {%- endcomment -%}
            {%- liquid
              assign sale_ends_at = ''

              if block.settings.end_date != blank
                assign end_time = block.settings.end_time | default: '23:59' | strip
                assign sale_ends_at = block.settings.end_date | strip | append: 'T' | append: end_time | append: ':00' | append: shop_offset
              endif

              if block.settings.allow_metafield_override and product.metafields.custom.sale_ends_at.value != blank
                assign sale_ends_at = product.metafields.custom.sale_ends_at.value | date: '%Y-%m-%dT%H:%M:%S%z'
              endif

              assign sale_live = false
              if sale_ends_at != blank
                assign sale_ends_ts = sale_ends_at | date: '%s' | plus: 0
                if sale_ends_ts > now_ts
                  assign sale_live = true
                endif
              endif
            -%}
            {%- if sale_live -%}
              <dds-countdown
                class="dds-pdp__sale"
                data-ends-at="{{ sale_ends_at }}"
                {{ block.shopify_attributes }}
              >
                <span class="dds-pdp__sale-label">{{ block.settings.label | escape }}</span>
                <span class="dds-pdp__sale-line" aria-hidden="true"><i data-countdown-bar></i></span>
                <span class="dds-pdp__sale-clock">
                  {{ block.settings.ends_label | escape }}
                  <b class="dds-pdp__sale-time" data-countdown-time>--:--:--</b>
                </span>
              </dds-countdown>
            {%- endif -%}

          {%- when 'variant_picker' -%}
            {%- comment -%}
              Single-variant products have nothing to pick — rendering the
              wrapper anyway left an empty white card on the page.
            {%- endcomment -%}
            {%- unless product.has_only_default_variant -%}
              <div class="dds-pdp__part dds-pdp__options{% unless in_buy %} dds-pdp__card{% endunless %}" {{ block.shopify_attributes }}>
                {%- render 'product-variant-picker',
                  product: product,
                  block: block,
                  product_form_id: product_form_id
                -%}
              </div>
            {%- endunless -%}

          {%- when 'quantity' -%}
            <div class="dds-pdp__part dds-pdp__qty-card{% unless in_buy %} dds-pdp__card{% endunless %}" {{ block.shopify_attributes }}>
              <div class="dds-pdp__qty-row">
                {%- comment -%}
                  Dawn's `quantity-input` snippet is the cart one — it posts
                  updates[id]. The product form needs name="quantity" bound to
                  the form by id, so this mirrors Dawn's own main-product markup.
                {%- endcomment -%}
                <label class="visually-hidden" for="DdsQuantity-{{ section.id }}">
                  {{- 'products.product.quantity.label' | t -}}
                </label>
                <quantity-input class="quantity dds-pdp__qty" data-url="{{ product.url }}" data-section="{{ section.id }}">
                  <button class="quantity__button" name="minus" type="button">
                    <span class="visually-hidden">
                      {{- 'products.product.quantity.decrease' | t: product: product.title | escape -}}
                    </span>
                    <span class="svg-wrapper">{{- 'icon-minus.svg' | inline_asset_content -}}</span>
                  </button>
                  <input
                    class="quantity__input"
                    type="number"
                    name="quantity"
                    id="DdsQuantity-{{ section.id }}"
                    data-min="{{ variant.quantity_rule.min }}"
                    min="{{ variant.quantity_rule.min }}"
                    {% if variant.quantity_rule.max != null %}
                      data-max="{{ variant.quantity_rule.max }}"
                      max="{{ variant.quantity_rule.max }}"
                    {% endif %}
                    step="{{ variant.quantity_rule.increment }}"
                    value="{{ variant.quantity_rule.min }}"
                    form="{{ product_form_id }}"
                  >
                  <button class="quantity__button" name="plus" type="button">
                    <span class="visually-hidden">
                      {{- 'products.product.quantity.increase' | t: product: product.title | escape -}}
                    </span>
                    <span class="svg-wrapper">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
                  </button>
                </quantity-input>
                {%- if variant.quantity_price_breaks.size > 0 -%}
                  {%- comment -%}
                    Real volume pricing from the variant's quantity price breaks.
                    Nothing is invented.
                  {%- endcomment -%}
                  {%- assign next_break = variant.quantity_price_breaks | sort: 'minimum_quantity' | first -%}
                  {%- assign break_saving = variant.price | minus: next_break.price -%}
                  <span class="dds-pdp__bulk">
                    {{ block.settings.bulk_prefix | escape }}
                    {{ next_break.minimum_quantity }}
                    {{ block.settings.bulk_middle | escape }}
                    {{ break_saving | money }}
                  </span>
                {%- endif -%}
              </div>
            </div>

          {%- when 'buy_buttons' -%}
            <div class="dds-pdp__part dds-pdp__cta" {{ block.shopify_attributes }}>
              <div class="dds-pdp__cta-inner">
                {%- if block.settings.show_whatsapp and settings.dds_whatsapp_number != blank -%}
                  {%- liquid
                    assign wa_number = settings.dds_whatsapp_number | remove: ' ' | remove: '+' | remove: '-'
                    assign wa_price = variant.price | money
                    assign wa_url = request.origin | append: product.url
                    assign wa_text = block.settings.whatsapp_message
                    assign wa_text = wa_text | replace: '[product]', product.title
                    assign wa_text = wa_text | replace: '[variant]', variant.title
                    assign wa_text = wa_text | replace: '[price]', wa_price
                    assign wa_text = wa_text | replace: '[url]', wa_url
                    # Encode only the message — encoding the whole href would break the scheme.
                    assign wa_text = wa_text | url_encode
                    assign wa_href = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_text
                  -%}
                  <a
                    class="dds-pdp__wa"
                    href="{{ wa_href }}"
                    target="_blank"
                    rel="noopener"
                    aria-label="{{ block.settings.whatsapp_label | escape }}"
                  >
                    {%- render 'icon-dds-whatsapp' -%}
                  </a>
                {%- endif -%}

                {%- render 'buy-buttons',
                  block: block,
                  product: product,
                  product_form_id: product_form_id,
                  section_id: section.id,
                  show_pickup_availability: false
                -%}
              </div>
            </div>

          {%- when 'delivery' -%}
            <div class="dds-pdp__card" {{ block.shopify_attributes }}>
              <div class="dds-pdp__blockhead">
                <h2>{{ block.settings.heading | escape }}</h2>
              </div>

              {%- if block.settings.delivery_lead != blank or block.settings.delivery_rest != blank -%}
                <p class="dds-pdp__line">
                  {%- render 'icon-dds-truck' -%}
                  <span class="dds-pdp__line-body">
                    <b class="dds-pdp__free">{{ block.settings.delivery_lead | escape }}</b>
                    {{ block.settings.delivery_rest | escape }}
                    {%- if block.settings.late_credit != blank -%}
                      <span aria-hidden="true"> &middot; </span>
                      <span class="dds-pdp__free">{{ block.settings.late_credit | escape }}</span>
                    {%- endif -%}
                  </span>
                </p>
              {%- endif -%}

              {%- if block.settings.cod_text != blank -%}
                <p class="dds-pdp__line">
                  {%- render 'icon-dds-card' -%}
                  <span class="dds-pdp__line-body">
                    <b>{{ block.settings.cod_lead | escape }}</b> {{ block.settings.cod_text | escape }}
                  </span>
                </p>
              {%- endif -%}

              {%- if block.settings.returns_text != blank -%}
                <p class="dds-pdp__line">
                  {%- render 'icon-dds-return' -%}
                  <span class="dds-pdp__line-body">
                    <b>{{ block.settings.returns_lead | escape }}</b> {{ block.settings.returns_text | escape }}
                  </span>
                </p>
              {%- endif -%}
            </div>

          {%- when 'store' -%}
            <div class="dds-pdp__card" {{ block.shopify_attributes }}>
              <div class="dds-pdp__store">
                {%- if settings.logo != blank -%}
                  <span class="dds-pdp__store-avatar">
                    {{ settings.logo | image_url: width: 120 | image_tag: alt: '', loading: 'lazy' }}
                  </span>
                {%- endif -%}
                <span class="dds-pdp__store-text">
                  <b>{{ shop.name }}</b>
                  {%- if block.settings.store_meta != blank -%}
                    <span>{{ block.settings.store_meta | escape }}</span>
                  {%- endif -%}
                </span>
                {%- if block.settings.follow_url != blank -%}
                  <a class="dds-pdp__follow" href="{{ block.settings.follow_url }}">
                    {{- block.settings.follow_label | escape -}}
                  </a>
                {%- endif -%}
              </div>

              {%- comment -%}
                Dawn's own social-icons snippet, reading the links from
                Theme settings → Social media. Renders an empty <ul> when no
                link is set, so the row is gated on there being at least one.
              {%- endcomment -%}
              {%- if block.settings.show_social -%}
                {%- liquid
                  assign social_links = settings.social_facebook_link
                  assign social_links = social_links | append: settings.social_instagram_link | append: settings.social_youtube_link
                  assign social_links = social_links | append: settings.social_tiktok_link | append: settings.social_twitter_link
                  assign social_links = social_links | append: settings.social_pinterest_link | append: settings.social_snapchat_link
                  assign social_links = social_links | append: settings.social_tumblr_link | append: settings.social_vimeo_link
                -%}
                {%- if social_links != blank -%}
                  <div class="dds-pdp__social">
                    {%- if block.settings.social_heading != blank -%}
                      <span class="dds-pdp__social-heading">{{ block.settings.social_heading | escape }}</span>
                    {%- endif -%}
                    {%- render 'social-icons', class: 'dds-pdp__social-list' -%}
                  </div>
                {%- endif -%}
              {%- endif -%}
            </div>

          {%- when 'accordion' -%}
            {%- assign acc_body = block.settings.content | append: block.settings.page.content -%}
            {%- if block.settings.heading != blank and acc_body != blank -%}
              <details
                class="dds-pdp__acc{% unless in_acc %} dds-pdp__card{% endunless %}"
                {% if section.settings.accordion_single_open %}name="dds-acc-{{ section.id }}"{% endif %}
                {% if block.settings.open_by_default %}open{% endif %}
                {{ block.shopify_attributes }}
              >
                <summary class="dds-pdp__acc-summary">
                  <span class="dds-pdp__acc-title">{{ block.settings.heading | escape }}</span>
                  {%- render 'icon-dds-chevron-right' -%}
                </summary>
                <div class="dds-pdp__acc-body rte">{{ acc_body }}</div>
              </details>
            {%- endif -%}

          {%- when 'trust' -%}
            {%- liquid
              assign trust_labels = ''
              for i in (1..4)
                assign key = 'label_' | append: i
                assign trust_labels = trust_labels | append: block.settings[key]
              endfor
            -%}
            {%- if trust_labels != blank -%}
              <div class="dds-pdp__card" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <div class="dds-pdp__blockhead">
                    <h2>{{ block.settings.heading | escape }}</h2>
                  </div>
                {%- endif -%}
                <ul class="dds-pdp__trust" role="list">
                  {%- for i in (1..4) -%}
                    {%- liquid
                      assign label_key = 'label_' | append: i
                      assign icon_key = 'icon_' | append: i
                      assign tone_key = 'tone_' | append: i
                      assign trust_label = block.settings[label_key]
                    -%}
                    {%- if trust_label != blank -%}
                      <li class="dds-pdp__trust-item dds-pdp__trust-item--{{ block.settings[tone_key] }}">
                        {%- render 'icon-dds-trust', name: block.settings[icon_key] -%}
                        <span>{{ trust_label | escape }}</span>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

          {%- when '@app' -%}
            {% render block %}

        {%- endcase -%}

        {%- if forloop.index == acc_last and acc_visible > 0 -%}</div>{%- endif -%}
        {%- if forloop.index == buy_last -%}</div>{%- endif -%}
        {%- if forloop.index == head_last -%}</div>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</product-info>

{% schema %}
{
  "name": "DDS main product",
  "tag": "section",
  "class": "dds-pdp-section",
  "settings": [
    {
      "type": "header",
      "content": "Savings strip"
    },
    {
      "type": "text",
      "id": "savings_tag",
      "label": "Tag label",
      "info": "The bolt chip at the start. Leave blank to hide it.",
      "default": "SAVINGS"
    },
    {
      "type": "text",
      "id": "savings_items",
      "label": "Promises",
      "info": "Comma separated. Rotates one at a time on mobile.",
      "default": "Free delivery, Rs 200 credit if late, Cash on Delivery"
    },
    {
      "type": "range",
      "id": "savings_rotate_speed",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "s",
      "label": "Change promise every",
      "default": 3
    },
    {
      "type": "header",
      "content": "Urgency"
    },
    {
      "type": "paragraph",
      "content": "Driven by real tracked inventory. Products with inventory tracking off, or with \"continue selling when out of stock\" on, never show the chip."
    },
    {
      "type": "text",
      "id": "urgency_label",
      "label": "Low stock chip",
      "info": "Leave blank to hide the chip entirely.",
      "default": "ALMOST SOLD OUT"
    },
    {
      "type": "range",
      "id": "urgency_threshold",
      "min": 1,
      "max": 50,
      "step": 1,
      "unit": "pcs",
      "label": "Show chip at or below",
      "default": 25
    },
    {
      "type": "header",
      "content": "Accordions"
    },
    {
      "type": "paragraph",
